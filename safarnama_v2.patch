+from sqlalchemy.orm import joinedload
+from src.models import db
+
+class PlaceRepository(BaseRepository[Place]):
+    def __init__(self):
+        super().__init__(Place)
+
+    def get_all_with_details(self):
+        # Using joinedload for performance (Eager loading)
+        return db.session.query(Place).options(
+            joinedload(Place.state),
+            joinedload(Place.city),
+            joinedload(Place.category),
+            joinedload(Place.tags)
+        ).all()
+
+place_repository = PlaceRepository()
