+from src.app_factory import create_app
+from src.models import db, Country, State, District, City, Village, Category, SubCategory, Tag, Activity, Place
+import os
+
+app = create_app()
+
+def seed():
+    with app.app_context():
+        # Clean existing data
+        db.drop_all()
+        db.create_all()
+
+        # Countries
+        india = Country(name="India", code="IN")
+        db.session.add(india)
+        db.session.flush()
+
+        # States
+        states_data = [
+            ("Meghalaya", "North-East"),
+            ("Maharashtra", "West"),
+            ("Karnataka", "South"),
+            ("Himachal Pradesh", "North"),
+            ("Kerala", "South")
+        ]
+        states_objs = {}
+        for name, region in states_data:
+            s = State(name=name, region=region, country_id=india.id)
+            db.session.add(s)
+            states_objs[name] = s
+        db.session.flush()
+
+        # Districts (simplified for seed)
+        districts_objs = {}
+        district_map = {
+            "Meghalaya": "West Jaintia Hills",
+            "Maharashtra": "Satara",
+            "Karnataka": "Shimoga",
+            "Himachal Pradesh": "Kullu",
+            "Kerala": "Idukki"
+        }
+        for s_name, d_name in district_map.items():
+            d = District(name=d_name, state_id=states_objs[s_name].id)
+            db.session.add(d)
+            districts_objs[s_name] = d
+        db.session.flush()
+
+        # Cities/Villages
+        cities_objs = {}
+        city_map = {
+            "Meghalaya": "Jowai",
+            "Maharashtra": "Satara",
+            "Karnataka": "Agumbe",
+            "Himachal Pradesh": "Sainj",
+            "Kerala": "Vagamon"
+        }
+        for s_name, c_name in city_map.items():
+            c = City(name=c_name, district_id=districts_objs[s_name].id, is_offbeat_hub=True)
+            db.session.add(c)
+            cities_objs[s_name] = c
+        db.session.flush()
+
+        # Categories
+        categories = ["Nature", "Adventure", "Heritage", "Religious"]
+        cat_objs = {}
+        for c in categories:
+            obj = Category(name=c)
+            db.session.add(obj)
+            cat_objs[c] = obj
+        db.session.flush()
+
+        # SubCategories
+        subcats = {
+            "Nature": ["Waterfall", "Meadow", "Hill"],
+            "Adventure": ["Trek", "Camping"]
+        }
+        subcat_objs = {}
+        for cat_name, sub_list in subcats.items():
+            for sub in sub_list:
+                obj = SubCategory(name=sub, category_id=cat_objs[cat_name].id)
+                db.session.add(obj)
+                subcat_objs[sub] = obj
+        db.session.flush()
+
+        # Tags
+        tags_list = ["Monsoon Spot", "Sunset Point", "Hidden Gem", "Offbeat"]
+        tag_objs = {}
+        for t in tags_list:
+            obj = Tag(name=t)
+            db.session.add(obj)
+            tag_objs[t] = obj
+        db.session.flush()
+
+        # Places
+        places_data = [
+            {
+                "name": "Phe Phe Falls",
+                "state": "Meghalaya",
+                "city": "Meghalaya",
+                "category": "Nature",
+                "subcat": "Waterfall",
+                "lat": 25.4410, "lon": 92.5165,
+                "desc": "A stunning two-tier waterfall hidden away from the mainstream commercial tourist tracks of Shillong.",
+                "reach": "Trek from Jowai",
+                "crowd": 2, "time": "Monsoon"
+            },
+            {
+                "name": "Shangarh Meadows",
+                "state": "Himachal Pradesh",
+                "city": "Himachal Pradesh",
+                "category": "Nature",
+                "subcat": "Meadow",
+                "lat": 31.6789, "lon": 77.3512,
+                "desc": "A pristine, wide-open green meadow inside the Great Himalayan National Park.",
+                "reach": "Drive from Sainj",
+                "crowd": 2, "time": "Summer/Winter"
+            }
+        ]
+
+        for p in places_data:
+            place = Place(
+                name=p["name"],
+                state_id=states_objs[p["state"]].id,
+                city_id=cities_objs[p["city"]].id,
+                category_id=cat_objs[p["category"]].id,
+                subcategory_id=subcat_objs[p["subcat"]].id,
+                latitude=p["lat"],
+                longitude=p["lon"],
+                description=p["desc"],
+                how_to_reach=p["reach"],
+                crowd_factor=p["crowd"],
+                best_time_to_visit=p["time"]
+            )
+            place.tags.append(tag_objs["Offbeat"])
+            place.tags.append(tag_objs["Hidden Gem"])
+            db.session.add(place)
+
+        db.session.commit()
+        print("Production-ready database seeded!")
+
+if __name__ == "__main__":
+    seed()
