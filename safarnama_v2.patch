+from flask import Blueprint, jsonify, request
+from src.services.place_service import place_service
+from src.schemas.place_schema import PlaceCreate
+
+router = Blueprint("places", __name__)
+
+@router.route("/", methods=["GET"])
+def get_places():
+    # Basic filters can be added here
+    places = place_service.get_all()
+    return jsonify([place.to_dict() for place in places])
+
+@router.route("/<id>", methods=["GET"])
+def get_place(id):
+    place = place_service.get_by_id(id)
+    if not place:
+        return jsonify({"error": "Place not found"}), 404
+    return jsonify(place.to_dict())
